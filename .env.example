# ANIVORA Global Environment Configuration

# Server
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql://anivora_user:anivora_secure_password@localhost:5432/anivora_db?schema=public

# Cache & Message Queue (Redis 7+)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=anivora_redis_secret
REDIS_URL=redis://:anivora_redis_secret@localhost:6380

# Authentication & Security
JWT_SECRET=super_secret_anivora_jwt_signing_key_change_in_production
JWT_EXPIRES_IN=86400

# Docker Infrastructure Configuration
POSTGRES_USER=anivora_user
POSTGRES_PASSWORD=anivora_secure_password
POSTGRES_DB=anivora_db
POSTGRES_PORT=5433
REDIS_PASSWORD=anivora_redis_secret
REDIS_PORT=6380
