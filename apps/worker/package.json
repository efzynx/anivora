    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "undici": "^6.19.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
